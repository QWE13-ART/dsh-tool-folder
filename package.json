{
    "name":  "dsh-tool-folder",
    "version":  "0.2.1",
    "description":  "Fold the DSH tool surface per request + ChainGuard firewall (high-risk block + exfil-chain detection + anti-obfuscation) + BM25/bge-m3 hybrid tools_search. Shrinks schema tokens 80-90% while keeping selection accuracy. v0.2.0 adds a semantic retrieval leg (local Ollama bge-m3, RRF hybrid) and ChainGuard obfuscation detection (concat-rebuild / -enc / certutil / bitsadmin / homoglyphs).",
    "keywords":  [
                     "dsh-plugin",
                     "dsh",
                     "deepseek-harness",
                     "cordis",
                     "tool-selection",
                     "token-optimization",
                     "bm25",
                     "semantic-search",
                     "security",
                     "firewall",
                     "obfuscation"
                 ],
    "type":  "module",
    "main":  "lib/index.js",
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "license":  "MIT",
    "engines":  {
                    "node":  "\u003e=18"
                },
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "^3.18.1"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-tools":  "^0.1.0-rc.6"
                         },
    "scripts":  {
                    "test":  "node --test \"test/*.test.js\""
                },
    "exports":  {
                    ".":  "./lib/index.js",
                    "./lib/*":  "./lib/*"
                }
}
